# =============================================================================
# Deep Research — environment configuration
# =============================================================================
# Copy this file to deploy/.env and set MINIMAX_API_KEY. Everything else is
# optional and has working defaults baked into the Docker Compose stack.
#
#   cp deploy/.env.example deploy/.env
#
# Read by docker compose (deploy/compose/docker-compose.yaml).
# Your real deploy/.env is git-ignored — never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the only value you must set to get running
# -----------------------------------------------------------------------------
# MiniMax API key. Get one at https://www.minimax.io/ (platform → API keys).
# The whole agent stack (planner, researchers, verifier, synthesis) runs on this.
MINIMAX_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — quality boosters (the app runs fully without these)
# -----------------------------------------------------------------------------
# NVIDIA NIM key. When set, search results are reranked with a cross-encoder and
# the local scrape corpus is embedded for semantic recall. Without it the app
# falls back to heuristic ranking + BM25 (still fully functional).
# Free keys at https://build.nvidia.com/
NVIDIA_API_KEY=

# Exa key. When set, Exa is added as a high-quality search provider. Without it,
# search uses the bundled SearXNG + DDGS only.
EXA_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — model selection
# -----------------------------------------------------------------------------
# This app is extensively tested with MiniMax M3, but the backend speaks the
# Anthropic-compatible API, so any model on that endpoint works. These all
# default to "MiniMax-M3"; override to try another MiniMax model per agent role.
# MINIMAX_PLANNER_MODEL=MiniMax-M3
# MINIMAX_RESEARCH_MODEL=MiniMax-M3
# MINIMAX_SYNTHESIS_MODEL=MiniMax-M3
# MINIMAX_VERIFIER_MODEL=MiniMax-M3
# MINIMAX_TEXT_MODEL=MiniMax-M3
# MINIMAX_FAST_MODEL=MiniMax-M3
#
# To point at a different Anthropic-compatible provider entirely, edit the
# base_url / api_key fields in configs/config_cli_minimax_ddgs.yml.

# -----------------------------------------------------------------------------
# OPTIONAL — ports (change if these are taken on your machine)
# -----------------------------------------------------------------------------
# FRONTEND_PORT=3000      # browser UI
# PORT=8000               # backend API
# SEARXNG_PORT=8080       # bundled metasearch

# -----------------------------------------------------------------------------
# OPTIONAL — backend config selection
# -----------------------------------------------------------------------------
# Workflow config the backend loads. Defaults to the MiniMax deep-research config.
# configs/ is mounted into the container at /app/configs.
#   - /app/configs/config_cli_minimax_ddgs.yml   (default: MiniMax + SearXNG)
#   - /app/configs/config_web_default_llamaindex.yml
# BACKEND_CONFIG=/app/configs/config_cli_minimax_ddgs.yml

# -----------------------------------------------------------------------------
# OPTIONAL — auth (off by default for private, single-user local use)
# -----------------------------------------------------------------------------
# Leave as-is for a private local instance. Turn these on only when exposing the
# app to others. Generate secrets with: openssl rand -base64 32
# REQUIRE_AUTH=false
# AIQ_LOCAL_AUTH_ENABLED=false
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# SECURE_COOKIES=false
# AIQ_AUTH_TOKEN_SECRET=
# AIQ_LOCAL_USERS=alice,bob          # seeded users (password defaults to username)
# AIQ_LOCAL_ADMIN_USERS=alice
# AIQ_AUTH_TOKEN_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# OPTIONAL — databases (default to the bundled Postgres; override for external)
# -----------------------------------------------------------------------------
# NAT_JOB_STORE_DB_URL=postgresql+asyncpg://aiq:aiq_dev@postgres:5432/aiq_jobs
# AIQ_CHECKPOINT_DB=postgresql://aiq:aiq_dev@postgres:5432/aiq_checkpoints

# -----------------------------------------------------------------------------
# OPTIONAL — frontend file upload limits
# -----------------------------------------------------------------------------
# FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.docx,.txt,.md
# FILE_UPLOAD_MAX_SIZE_MB=100
# FILE_UPLOAD_MAX_FILE_COUNT=10

# -----------------------------------------------------------------------------
# OPTIONAL — logging
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# APP_ENV=production
