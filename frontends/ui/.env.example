# =============================================================================
# AIQ Blueprint UI - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# =============================================================================
# Backend Configuration
# =============================================================================
# Backend URL - runtime configurable (no rebuild needed for containers)
# BACKEND_URL=http://localhost:8000
#
# For research.genalphai.com or another VPS-hosted frontend, BACKEND_URL must
# point to your local backend through a tunnel (for example
# BACKEND_URL=http://127.0.0.1:9000 when ssh -R exposes your Mac's backend on
# the VPS). Do not leave this as localhost unless the backend is actually
# running on the VPS.
#
# Optional emergency override. Leave false so the visible Shallow/Deeper/Deep
# mode selector controls routing.
# NEXT_PUBLIC_FORCE_DEEP_RESEARCH=false

# =============================================================================
# Kokoro Audio Narration
# =============================================================================
# Optional OpenAI-compatible Kokoro server. If this is not reachable, the UI
# falls back to local kokoro-onnx synthesis through the repo's Python venv.
# KOKORO_TTS_URL=http://127.0.0.1:8881
#
# Local fallback defaults:
# AIQ_RESEARCH_ROOT=/Volumes/SrijanExt/Users/Srijan/Downloads/code/minimax/nvda-deep-research
# KOKORO_PYTHON=/Volumes/SrijanExt/Users/Srijan/Downloads/code/minimax/nvda-deep-research/.venv/bin/python
# KOKORO_MODEL_DIR=/Volumes/SrijanExt/Users/Srijan/Downloads/code/minimax/nvda-deep-research/data/kokoro-models
#
# Missing model files are downloaded automatically by default. Set to 0 to
# require the files to be placed manually in KOKORO_MODEL_DIR.
# KOKORO_AUTO_DOWNLOAD=1
# KOKORO_MODEL_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx
# KOKORO_VOICES_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin

# =============================================================================
# Authentication
# =============================================================================
# Authentication is DISABLED by default. The app works with "Default User"
# and no login is required.
#
# To enable local username/password authentication, set REQUIRE_AUTH=true,
# AIQ_LOCAL_AUTH_ENABLED=true, and configure the backend with the same auth mode.
# REQUIRE_AUTH=true
# AIQ_LOCAL_AUTH_ENABLED=true

# NextAuth configuration (required when REQUIRE_AUTH=true)
# Generate secret with: openssl rand -base64 32
#
# IMPORTANT: NEXTAUTH_URL determines cookie security:
#   - http://...  → non-secure cookies (works over HTTP)
#   - https://... → secure cookies only (required for HTTPS)
#
# For reverse proxy setups (TLS terminated at proxy), set NEXTAUTH_URL
# to the external HTTPS URL, not the internal HTTP URL.
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Optional: Explicit cookie security override (rarely needed)
# SECURE_COOKIES=true

# Session and token lifetime tuning (optional)
#
# Session max age in hours (applies to both NextAuth session and idToken cookie).
# Default: 24. Both MUST stay aligned to prevent stale-credential bugs.
# SESSION_MAX_AGE_HOURS=24
#
# Minutes before token expiry to trigger proactive refresh.
# Default: 15. For enterprise deployments with long-running jobs (deep research
# with ECI runs 20-40+ minutes), set to 30 to prevent mid-job 401 errors.
# The browser session poll interval is derived from this as buffer minus 1 minute
# with a 1-minute floor.
# TOKEN_REFRESH_BUFFER_MINUTES=15

# =============================================================================
# OAuth Provider (optional alternative to local username/password auth)
# =============================================================================
# Configure your OIDC-compatible identity provider (Keycloak, Auth0, Okta, etc.)
#
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/callback/oauth

# OAuth issuer - enables OIDC auto-discovery (recommended)
# OAUTH_ISSUER=https://your-provider.example.com

# OAuth endpoints (optional if OAUTH_ISSUER is set for auto-discovery)
# OAUTH_AUTH_URL=https://your-provider.example.com/authorize
# OAUTH_TOKEN_URL=https://your-provider.example.com/token
# OAUTH_USERINFO_URL=https://your-provider.example.com/userinfo

# =============================================================================
# File Upload Configuration
# =============================================================================
# These settings control file upload validation in the knowledge layer.
# Values should match backend limits for consistent user experience.

# Accepted file extensions (comma-separated, include leading dots)
# FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.txt,.md,.docx,.pptx

# Maximum total file size in MB
# FILE_UPLOAD_MAX_SIZE_MB=100

# Maximum number of files per session
# FILE_UPLOAD_MAX_FILE_COUNT=10

# Hours after upload before files may expire on the backend (0 = no expiry shown),
#this should ideally match TTL of the files on the backend (e.g. 12 hours)
# FILE_EXPIRATION_CHECK_INTERVAL_HOURS=0
