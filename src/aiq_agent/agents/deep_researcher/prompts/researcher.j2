      "preferred_source_classes": ["primary_issuer"],
      "status": "partially_verified",
      "resolved_value": "$5.5 trillion",
      "evidence": [
        {
          "source_url": "https://secondary-source.example/...",
          "source_class": "content_marketing",
          "extract": "The exact snippet that says the blog attributes this number to IDC",
          "extract_confidence": "low"
        }
      ],
      "hedge_required": true,
      "hedge_phrase": "reported by secondary coverage; primary IDC source not verified",
